# Sao chép tệp này thành ".env" rồi điền giá trị. KHÔNG đưa tệp .env lên GitHub.

# Khoá Gemini (lấy tại https://aistudio.google.com/apikey). Để trống: AI Import chạy bằng quy tắc, không có "Hỏi AI".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mã biên tập cho Studio. BẮT BUỘC đặt nếu mở Studio ra mạng nội bộ (EDITOR_BIND=0.0.0.0).
EDITOR_TOKEN=
# 127.0.0.1 = chỉ truy cập Studio ngay trên Mac mini. 0.0.0.0 = cho phép máy khác trong mạng LAN.
EDITOR_BIND=127.0.0.1

PUBLIC_PORT=8080
EDITOR_PORT=8081

# --- Zalo Bot: nhận thông báo khi người dùng gửi yêu cầu hỗ trợ ---
# 1) Trên Zalo, mở "Zalo Bot Manager", tạo bot và chép Bot Token vào đây.
# 2) Nhắn một tin bất kỳ cho bot, rồi vào Studio > Yêu cầu > "Tìm chat_id" để lấy mã và điền vào ZALO_CHAT_ID.
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=
# Địa chỉ công khai của website (https://...). Có thì Zalo nhận được cả ảnh chụp màn hình; để trống thì chỉ gửi chữ.
PUBLIC_BASE_URL=

# Thông tin hỗ trợ hiển thị ở chân trang (để trống nếu chưa có)
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_ZALO=
SUPPORT_HOURS=

# Số câu "Hỏi AI" tối đa mỗi ngày (bảo vệ hạn mức Gemini)
ASK_DAILY_LIMIT=500
# Đặt 0 để KHÔNG nạp 10 bài mẫu khi cơ sở dữ liệu trống
SF_SEED=1
